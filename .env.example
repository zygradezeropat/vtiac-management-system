# Copy to .env and adjust — this system uses PostgreSQL.
# Export these in your shell (or use a loader) before migrate/runserver.

POSTGRES_DB=vtiac
POSTGRES_USER=vtiac
POSTGRES_PASSWORD=vtiac
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django superuser (optional, for: python manage.py createsuperuser)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
# Gmail SMTP Credentials

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Local Environment Variables (Ignored by Git)
SECRET_KEY=
DEBUG=

# Supabase S3 Storage (Required on Render/Production for uploads)
USE_SUPABASE_STORAGE=true
SUPABASE_S3_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_BUCKET=media
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=ap-southeast-1
